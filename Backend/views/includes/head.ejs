<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= t('site_title') %></title>

<link href="/style.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<!-- Devanagari font for Hindi -->
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;700&display=swap" rel="stylesheet">

<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family: 'Roboto', sans-serif; }
  body { background-color: #e4f0ff; color: #343a40; line-height: 1.6; }
  html[lang="hi"] body { font-family: "Noto Sans Devanagari", system-ui, sans-serif; }
  /* put any other shared CSS you like here, or keep using /style.css */
</style>

<!-- expose current lang to client scripts -->
<script>window.__LANG__ = "<%= htmlLang %>";</script>
