<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Schedule</title>
</head>
<style>
    body{
        background-color: #F0F2EF;
    }
    h1{
        font-family: "Playfair Display", serif;
        font-optical-sizing: auto;
        font-size:4rem;
        color:#262730;
    }
    .header{
        text-align: center;
    }
    .content{
        display:flex;
        justify-content: center;
        align-items: center;
        height:60vh;
        margin:2rem 4rem;
    }
    table {
        border-collapse: collapse;
        border: 2px solid rgb(140 140 140);
        height:100%;
        width:100%;

    }
    th{
        border: 2px solid rgb(160 160 160);
        font-family: "PT Serif", serif;
        font-size:1.5rem;
        font-weight:600;
    }
    td{
        border: 2px solid rgb(160 160 160);
        font-family: "Raleway", serif;
        font-size:1.2rem;
        font-weight:500;
        text-align: center;
    }
    a{
        text-decoration: none;
        color:blue;
    }
    .disabled{
        color:grey;
        pointer-events: none;
    }
</style>
<body>
    <%- include("./includes/flash.ejs") %>
    <div class="header">
        <h1>Schedule</h1>
    </div>

    <div class="content">
        <table style = "border:2px solid black">
            <thead>
                <tr>
                    <th scope="col">Day</th>
                    <th scope="col">Period</th>
                    <th scope="col">Subject</th>
                    <th scope="col">Time</th>
                </tr>
            </thead>
            <tbody>
                <% for (let scheduleItem of schedule) { %>
                    <tr data-end-time="<%= scheduleItem.end_time %>">
                        <td><%= scheduleItem.day %></td>
                        <td><%= scheduleItem.P_NO %></td>
                        <td>
                            <a 
                              href="http://localhost:8080/teacher/feedback?TID=<%= TID %>&SUBID=<%= scheduleItem.SUBID %>&DAY=<%= scheduleItem.day %>&PERIOD=<%= scheduleItem.P_NO %>" 
                              class="feedback-link <%= scheduleItem.feedbackSubmitted ? 'disabled' : '' %>">
                              <%= scheduleItem.subname %>
                            </a>
                        </td>
                        <td><%= scheduleItem.start_time %> - <%= scheduleItem.end_time %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <script>
        function combineTimeWithToday(timeStr) {
            const today = new Date();
            const datePart = today.toISOString().split('T')[0];
            return new Date(`${datePart}T${timeStr}`);
        }

        document.querySelectorAll("tr[data-end-time]").forEach(row => {
            const endTimeStr = row.getAttribute("data-end-time");
            const endTime = combineTimeWithToday(endTimeStr);
            const now = new Date();

            if (endTime > now) {
                const link = row.querySelector(".feedback-link");
                if (!link.classList.contains("disabled")) {
                    link.classList.add("disabled");
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
</body>
</html>
