<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <title><%=t('studentDashboard.title')%>></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .container {
            width: 80%;
            margin: auto;
            overflow: hidden;
        }
        header {
            background: #008DD5;
            color: #ffffff;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative; /* important for absolute positioning inside */
        }
        .nav-anchor-container {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
        }
        .nav-anchor {
            text-decoration: none;
            color: #ddd;
            font-weight:bold;
            font-size: large;
        }
        .nav-anchor:hover {
            color: blue;
        }
        .card {
            background: #ffffff;
            margin: 20px 0;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }
        .tabs {
            display: flex;
            justify-content: space-around;
            background: #fff;
            padding: 10px;
        }
        .tab {
            padding: 10px 20px;
            cursor: pointer;
            background: #85FFC7;
            border-radius: 5px;
        }
        .tab:hover {
            background: #bbb;
        }
    </style>
</head>
<body>

    <%- include("./includes/flash.ejs") %>
      
      
    <header>
        <h1><%=t('studentDashboard.welcome')%> <%=student.sname%>!</h1>
        <div class="nav-anchor-container"><a href="/logout" class="nav-anchor"><%=t('studentDashboard.logout')%></a></div>
    </header>
    
    <div class="container">
        <div class="tabs">
            <a href="http://localhost:8080/" style="text-decoration: none;color: black;" class="tab">📌 <%=t('studentDashboard.home')%></a>
            <a href="http://localhost:8080/schedule?SID=<%=student.SID%>" style="text-decoration: none;color: black;" class="tab">📝 <%=t('studentDashboard.submitFeedback')%></a>
            <a href="http://localhost:8080/schedule" style="text-decoration: none;color: black;" class="tab">📊 <%=t('studentDashboard.schedule')%></a>
            <a style="text-decoration: none;color: black;" class="tab">📢 <%=t('studentDashboard.announcements')%></a>
        </div>
        
        <div class="card">
            <h2><%=t('studentDashboard.todayClasses')%></h2>
            <p style="font-size:1.2rem;"><%=t('studentDashboard.todayClassesAnnouncement')%></p>
        </div>
        
        <div class="card">
            <h2><%=t('studentDashboard.submitFeedback')%></h2>
            <a href="http://localhost:8080/schedule?SID=<%=student.SID%>"><button class="btn btn-primary" type="submit" style="width:10%"><%=t('studentDashboard.feedbackBtn')%></button></a>
        </div>
        
        <div class="card">
            <h2><%=t('studentDashboard.performance')%></h2>
            <table border="1" width="100%" style="text-align: left; border-collapse: collapse;">
                <tr>
                    <th><%=t('studentDashboard.subject')%></th>
                    <th><%=t('studentDashboard.score')%></th>
                </tr>
                <tr>
                    <td><%=t('studentDashboard.math')%></td>
                    <td>80%</td>
                </tr>
                <tr>
                    <td><%=t('studentDashboard.science')%></td>
                    <td>90%</td>
                </tr>
            </table>
        </div>
        
        <div class="card">
            <h2><%=t('studentDashboard.announcements')%></h2>
            <ul>
                <li>📢 <%=t('studentDashboard.examAnnouncement')%></li>
                <li>📢 <%=t('studentDashboard.libraryAnnouncement')%></li>
            </ul>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const alertEl = document.querySelector('.alert');
          if (alertEl) {
            setTimeout(() => {
              alertEl.classList.remove('show'); // hides alert with fade-out effect
              alertEl.classList.add('fade');
            }, 5000); // 5 seconds
          }
        });
      </script>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>      
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
</html>
