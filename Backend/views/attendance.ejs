<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Attendance Dashboard</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: white;
            text-align: center;
        }

        h1 {
            margin-top: 20px;
            color: #38bdf8;
        }

        .stats {
            margin-top: 15px;
            display: flex;
            justify-content: center;
            gap: 30px;
            font-size: 18px;
        }

        .stat-box {
            padding: 10px 20px;
            border-radius: 10px;
            background: #1e293b;
        }

        .present-count { color: #22c55e; }
        .absent-count { color: #ef4444; }
        .total-count { color: #facc15; }

        table {
            margin: 30px auto;
            border-collapse: collapse;
            width: 70%;
            background: #1e293b;
            border-radius: 10px;
            overflow: hidden;
        }

        th, td {
            padding: 15px;
            text-align: center;
            border-bottom: 1px solid #334155;
        }

        th {
            background: #020617;
            font-size: 18px;
        }

        tr:hover {
            background: #334155;
        }

        .present { color: #22c55e; font-weight: bold; }
        .absent { color: #ef4444; font-weight: bold; }
        .tc { color: #facc15; font-weight: bold; }

        .list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
        }

        .badge {
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 14px;
            background: #334155;
        }
    </style>
</head>
<body>

    <h1>📊 Attendance Dashboard</h1>

    <%
        let total = new Set();
        for (let i = 1; i <= 65; i++) total.add(i);

        let tc = new Set([12,25,30,31,37,38,57,59]);

        let absents = new Set([...total].filter(x => !presents.has(x) && !tc.has(x)));

        let presentCount = presents.size;
        let absentCount = absents.size;
        let totalEffective = total.size - tc.size; // 57
    %>

    <!-- 🔥 COUNTS -->
    <div class="stats">
        <div class="stat-box present-count">
            ✅ Present: <%= presentCount %>
        </div>
        <div class="stat-box absent-count">
            ❌ Absent: <%= absentCount %>
        </div>
        <div class="stat-box total-count">
            🎯 Total Strength: <%= totalEffective %>
        </div>
    </div>

    <table>
        <tr>
            <th class="present">✅ Present</th>
            <th class="absent">❌ Absent</th>
            <th class="tc">⚠️ TC</th>
        </tr>

        <tr>
            <td>
                <div class="list">
                    <% presents.forEach(p => { %>
                        <div class="badge present"><%= p %></div>
                    <% }) %>
                </div>
            </td>

            <td>
                <div class="list">
                    <% absents.forEach(a => { %>
                        <div class="badge absent"><%= a %></div>
                    <% }) %>
                </div>
            </td>

            <td>
                <div class="list">
                    <% tc.forEach(t => { %>
                        <div class="badge tc"><%= t %></div>
                    <% }) %>
                </div>
            </td>
        </tr>
    </table>

</body>
</html>
