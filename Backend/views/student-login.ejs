<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('includes/head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%=t('studentLogin.title')%></title>
  <style>
    /* Basic styling */
    body { font-family: Arial, sans-serif; background: #f2f2f2; }
    .login-container { max-width: 400px; margin: 50px auto; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
    .login-button { width: 100%; padding: 10px; background: #007BFF; border: none; color: #fff; margin-top: 10px; border-radius: 4px; cursor: pointer; }
    .login-button:hover { background: #0056b3; }
    .error-message { color: #d9534f; text-align: center; margin-bottom: 15px; display: none; }
    label{
      font-weight:600;
    }
  </style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
  <div class="login-container">
    <h2><%=t('studentLogin.title')%></h2>
    <div class="error-message" id="error-message"></div>
    <%- include("./includes/flash.ejs") %>

    <!-- 1. Student Login Form -->
    <form id="student-login-form" method="POST" action="/oldstudent" >
      <div class="form-group">
                    <label for="school" class="form-label"><%=t('studentLogin.labels.school')%></label>
                    <select id="school" class="form-select" name="school" required>
                        <option value="" selected disabled>Select</option>
                        <option value="St.Paul's School">St.Paul's School</option>
                        <option value="Paradise">Paradise</option>
                        <option value="D.A.V. School">D.A.V. School</option>
                        <option value="Gems English School">Gems English School</option>
                    </select>
                    <div class="invalid-feedback">
                      <%=t('studentLogin.error.selectSchool')%>
                    </div>
      </div>
        <div class="form-group">
        <label for="class" class="form-label"><%=t('studentLogin.labels.class')%></label>
        <input type="text" id="class" name="class" placeholder="Enter your class" class="form-control" required>
        <div class="invalid-feedback">
           <%=t('studentLogin.error.invalidClass')%>
        </div>
      </div>
      <div class="form-group">
        <label for="roll_no" class="form-label"><%=t('studentLogin.labels.roll')%></label>
        <input type="text" id="roll_no" name="roll_no" placeholder="Enter your roll number" class="form-control" required>
        <div class="invalid-feedback">
          <%=t('studentLogin.error.invalidRoll')%>
        </div>
      </div>
      <button type="submit" class="login-button"><%=t('studentLogin.loginBtn')%></button>
    </form>

    <!-- 2. OTP Request Form -->
    <form id="otp-request-form" method="POST" action="/api/otp/request" >
      <div class="form-group">
        <label for="sphone_no" class="form-label"><%=t('studentLogin.labels.phone')%></label>
        <input type="tel" id="sphone_no" name="phoneNumber" placeholder="+91XXXXXXXXXX" pattern="\+\d{10,15}" class="form-control" required>
        <div class="invalid-feedback">
          <%=t('studentLogin.error.invalidPhone')%>
        </div>
      </div>
      <button type="submit" class="login-button"><%=t('studentLogin.sendOtpBtn')%></button>
    </form>

    <!-- 3. OTP Verification Form -->
    <form id="otp-verify-form" method="POST" action="/api/otp/verify">
      <div class="form-group">
        <label for="otpInput" ><%=t('studentLogin.labels.otp')%></label>
        <input type="number" id="otpInput" name="otp" placeholder="Enter OTP" required>
      </div>
      <!-- Hidden input to hold the phone number -->
      <input type="hidden" id="verifyPhoneNumber" name="phoneNumber">
      <button type="submit" class="login-button"><%=t('studentLogin.verifyOtpBtn')%></button>
    </form>
  </div>

  <script>
    console.log("script loaded!");
    let redirectUrl = null;
    document.addEventListener('DOMContentLoaded', () => {
      const studentLoginForm = document.getElementById('student-login-form');
      const otpRequestForm = document.getElementById('otp-request-form');
      const otpVerifyForm = document.getElementById('otp-verify-form');
      const errorMessage = document.getElementById('error-message');

      // Initially, only the student login form is visible.
      studentLoginForm.style.display = 'block';
      otpRequestForm.style.display = 'none';
      otpVerifyForm.style.display = 'none';

      // Helper function to show error messages.
      const showError = (msg) => {
        errorMessage.textContent = msg;
        errorMessage.style.display = 'block';
      };

      // Handle Student Login Form Submission
      studentLoginForm.addEventListener('submit', async (e) => {
        //console.log("Login form check point 1");
        e.preventDefault();
        //console.log("Login form check point 2");
        const formData = new FormData(studentLoginForm);
        const data = {
          school:formData.get('school'),
          class: formData.get('class'),
          roll_no: formData.get('roll_no')
        };
        //console.log("Login form check point 3");
        //console.log(data);

        try {
          //console.log("Login form check point 4");
          const response = await fetch(studentLoginForm.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(data)
          });
          //console.log("Login form check point 5");
          //console.log(response);
          if (response.ok) {
            const data = await response.json();//Parse the json
            //console.log(data);
            redirectUrl = data.redirectUrl;
            //console.log("redirectUrl: " + redirectUrl);
            // Hide login form and show OTP request form.
            studentLoginForm.style.display = 'none';
            otpRequestForm.style.display = 'block';
            errorMessage.style.display = 'none';
          } else {
            const err = await response.json();
            console.log(err);
            showError(err.error);
            return;
            //showError('Invalid login credentials. Please try again.');
          }
        } catch (err) {
          console.error('Login error:', err);
          showError('Error processing login. Please try again later.');
        }
      });

      // Handle OTP Request Form Submission
      otpRequestForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(otpRequestForm);
        const phoneNumber = formData.get('phoneNumber');  // Get phone number.
        const data = { phoneNumber };

        try {
          const response = await fetch(otpRequestForm.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          if (response.ok) {
            // Hide OTP request form, show OTP verification form, and store the phone number.
            otpRequestForm.style.display = 'none';
            otpVerifyForm.style.display = 'block';
            errorMessage.style.display = 'none';
            document.getElementById('verifyPhoneNumber').value = phoneNumber;
          } else {
            console.error('Error status:', response.status);
            const errorText = await response.text();
            console.error('Error message:', errorText);
            console.log("Hello");
            console.log(response.status);
            console.log(response);
            showError('Failed to send OTP. Please try again.');
          }
        } catch (err) {
          console.error('OTP request error:', err);
          console.log("Hello2");
          console.log("Error:" + err);
          showError('Error requesting OTP. Please try again later.');
        }
      });

      // Handle OTP Verification Form Submission
      otpVerifyForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(otpVerifyForm);
        const data = {
          otp: formData.get('otp'),
          phoneNumber: document.getElementById('verifyPhoneNumber').value
        };

        try {
          console.log("Sending Verification Request");
          const response = await fetch(otpVerifyForm.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          console.log(response);
          if (response.ok) {
            // OTP is verified; redirect the student to the dashboard.
            window.location.href = redirectUrl;  // Change the route as needed.
          } else {
            console.error('Error status:', response.status);
            const errorText = await response.text();
            console.error('Error message:', errorText);
            console.log("Hello");
            console.log(response.status);
            console.log(response);
            showError('OTP verification failed. Please try again.');
          }
        } catch (err) {
          console.error('OTP verification error:', err);
          console.log("Hello ji");
          console.log(err);
          showError('Error verifying OTP. Please try again later.');
        }
      });
    });
  </script>
  <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>-->
</body>
</html>
