<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('includes/head') %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%=t('studentRegister.title')%></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Special+Gothic&display=swap" rel="stylesheet">
</head>
<style>
  *{
    font-family: "Plus Jakarta Sans", sans-serif;
  }
  body {
    font-family: 'Roboto', sans-serif;
    background: #f3f4f6;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 40px;
  }

  .form-container {
    background: white;
    padding: 30px 40px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    max-width: 600px;
    width: 100%;
  }

  h2 {
    text-align: center;
    margin-bottom: 25px;
    color: #333;
  }

  .form-item,.form-group {
    margin-bottom: 15px;
  }

  label {
    display: block;
    margin-bottom: 6px;
    color: #333;
    font-weight: 600;
  }

  input, select {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 14px;
  }

  input:focus, select:focus {
    border-color: #3b82f6;
    outline: none;
  }

  .btn-submit {
    width: 100%;
    padding: 12px;
    background-color: #3b82f6;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
    margin-top: 20px;
  }

  .btn-submit:hover {
    background-color: #2563eb;
  }
</style>
<body>
  <%- include("./includes/flash.ejs") %>
  <div class="form-container">
    <h2><%=t('studentRegister.title')%></h2>
    <form method="POST" action="/newstudent"  class="needs-validation" novalidate>

        <div class="form-item">
                    <label for="school" class="form-label"><%=t('studentRegister.labels.school')%></label>
                    <select id="school" class="form-select" name="school" required>
                        <option value="" selected disabled>Select</option>
                        <option value="St.Paul's School">St.Paul's School</option>
                        <option value="Paradise Childrens' Academy">Paradise</option>
                        <option value="D.A.V. School">D.A.V. School</option>
                        <option value="Gems English School">Gems English School</option>
                    </select>
                    <div class="invalid-feedback">
                      Please Select a valid School
                    </div>
        </div>

      <div class="row">
        <div class="form-item col-md-4">
        <label for="roll_no" class="form-label"><%=t('studentRegister.labels.roll')%></label>
        <input type="number" id="roll_no" name="roll_no" class="form-control" required />
        <div class="invalid-feedback">
          Roll Number is invalid
        </div>
        </div>

        <div class="form-item col-md-8">
          <div class="form-group">
            <label for="class"><%=t('studentRegister.labels.class')%></label>
            <input type="number" id="class" name="class" class="form-control" required />
            <div class="invalid-feedback">
              Class is invalid
            </div>
          </div>
        </div>
    
      </div>

      <div class="form-item">
        <div class="form-group">
          <label for="sname" class="form-label"><%=t('studentRegister.labels.name')%></label>
          <input type="text" id="sname" name="sname" class="form-control" required />
          <div class="invalid-feedback">
            Name is invalid
          </div>
        </div>
      </div>

      <div class="form-item">
        <div class="form-group">
          <label for="sphone_no" class="form-label"><%=t('studentRegister.labels.studentPhone')%>(<%=t('studentRegister.labels.optional')%>)</label>
          <input type="tel" id="sphone_no" name="sphone_no" class="form-control" />
          <div class="invalid-feedback">
              Phone Number is invalid
          </div>
        </div>
      </div>

      <div class="form-item">
        <label for="parent_phone_no" class="form-label"><%=t('studentRegister.labels.parentPhone')%></label>
        <input type="tel" id="parent_phone_no" name="parent_phone_no" class="form-control" required />
        <div class="invalid-feedback">
          Phone Number is invalid
        </div>
      </div>

      <div class="form-item">
        <label for="dob" class="form-label"><%=t('studentRegister.labels.dob')%></label>
        <input type="date" id="dob" name="dob" class="form-control" required />
        <div class="invalid-feedback">
          DOB is invalid
        </div>
      </div>

      <div class="form-item">
        <label for="aadhar_no" class="form-label"><%=t('studentRegister.labels.aadhar')%></label>
        <input type="text" id="aadhar_no" name="aadhar_no" maxlength="12" class="form-control" required />
        <div class="invalid-feedback">
          Aadhar Number is invalid
        </div>
      </div>

      <div class="form-item">
        <label for="village" class="form-label"><%=t('studentRegister.labels.village')%></label>
        <input type="text" id="village" name="village" class="form-control" required />
        <div class="invalid-feedback">
          Village is invalid
        </div>
      </div>

      <div class="form-item">
        <label for="district" class="form-label"><%=t('studentRegister.labels.district')%></label>
        <input type="text" id="district" name="district" class="form-control" required />
        <div class="invalid-feedback">
          District is invalid
        </div>
      </div>

      <div class="form-item">
        <div class="form-group">
          <label for="state" class="form-label"><%=t('studentRegister.labels.state')%></label>
          <input type="text" id="state" name="state" class="form-control" required />
          <div class="invalid-feedback">
            State is invalid
          </div>
        </div>
      </div>

      <div class="form-item">
        <div class="form-group">
          <label for="country" class="form-label"><%=t('studentRegister.labels.country')%></label>
          <input type="text" id="country" name="country" class="form-control" required />
          <div class="invalid-feedback">
            Country is invalid
          </div>
        </div>
      </div>

      <button type="submit" class="btn-submit"><%=t('studentRegister.submitBtn')%></button>
    </form>
  </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="/js/script.js"></script>
</html>
